  "usersSummaryTable": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "ba-project-staff-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "usersInfoTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[{\"exists\":{\"field\":\"Data.boundaryHierarchy.district\"}}]}},\"_source\":[\"Data.userId\",\"Data.userName\",\"Data.role\",\"Data.boundaryHierarchyCode.district\" ,\"Data.boundaryHierarchyCode.province\" ,\"Data.boundaryHierarchy.district\", \"Data.boundaryHierarchy.province\", \"Data.nameOfUser\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.createdTime",
        "requestQueryMap": "{\"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "ba-user-sync-index-v1",
        "transformData": "termsAggregation",
        "transformKey": "termsSampleTransformer",
        "aggrQuery": "{\"size\":0,\"query\":{\"bool\":{\"must\":[{\"exists\":{\"field\":\"Data.boundaryHierarchy.district\"}}]}},\"aggs\":{\"Username\":{\"terms\":{\"field\":\"Data.syncedUserId.keyword\",\"size\":10000},\"aggs\":{\"LatestSyncedTime\":{\"max\":{\"field\":\"Data.syncedTimeStamp\"}},\"RecordTotal\":{\"value_count\":{\"field\":\"Data.syncedTimeStamp\"}},\"Last3Hours\":{\"filter\":{\"range\":{\"Data.syncedTimeStamp\":{\"gte\":\"now-200d\",\"lte\":\"now\"}}}},\"LatestDoc\":{\"top_hits\":{\"size\":1,\"sort\":[{\"Data.syncedTimeStamp\":{\"order\":\"desc\"}}],\"_source\":{\"includes\":[\"Data.syncedUserName\",\"Data.@timestamp\",\"Data.boundaryHierarchy.district\",\"Data.boundaryHierarchy.province\",\"Data.role\",\"Data.syncedTimeStamp\",\"Data.nameOfUser\"]}}}}}}}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "usersInfoTransformer": {
        "transformationMappings": [
          {
            "userId": "Data.userId",
            "userName": "Data.userName",
            "nameOfUser": "Data.nameOfUser",
            "role": "Data.role",
            "province": "Data.boundaryHierarchy.province",
            "district": "Data.boundaryHierarchy.district",
            "provinceCode": "Data.boundaryHierarchyCode.province",
            "districtCode": "Data.boundaryHierarchyCode.district"
          }
        ]
      },
      "termsSampleTransformer": {
        "bucketsPath": "Username.buckets",
        "transformationMappings": [
          {
            "userId": "key",
            "userName": "LatestDoc.hits.hits[0]._source.Data.syncedUserName",
            "nameOfUser": "LatestDoc.hits.hits[0]._source.Data.nameOfUser",
            "role": "LatestDoc.hits.hits[0]._source.Data.role",
            "province": "LatestDoc.hits.hits[0]._source.Data.boundaryHierarchy.province",
            "district": "LatestDoc.hits.hits[0]._source.Data.boundaryHierarchy.district",
            "totalRecords": "RecordTotal.value",
            "latestSyncTime": "LatestSyncedTime.value_as_string",
            "latestSyncEpoch": "toNumber(LatestSyncedTime.value)",
            "active": "Last3Hours.doc_count > 0 ? 'ACTIVE' : 'INACTIVE'"
          }
        ]
      }
    },
    "merges": [
      {
        "mergeKey": "mergedUsersSummary",
        "baseDataset": "usersInfoTransformer",
        "dataset": "termsSampleTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "full",
        "clearDatasets2": [],
        "clearDatasets": [
          "usersInfoTransformer",
          "termsSampleTransformer"
        ],
        "outputMappings": [
          {
            "userId": "usersInfoTransformer.userId ? usersInfoTransformer.userId : termsSampleTransformer.userId",
            "userName": "usersInfoTransformer.userName ? usersInfoTransformer.userName : termsSampleTransformer.userName",
            "nameOfUser": "usersInfoTransformer.nameOfUser ? usersInfoTransformer.nameOfUser : termsSampleTransformer.nameOfUser",
            "role": "usersInfoTransformer.role ? usersInfoTransformer.role: termsSampleTransformer.role",
            "province": "usersInfoTransformer.province ? usersInfoTransformer.province: termsSampleTransformer.province",
            "district": "usersInfoTransformer.district ? usersInfoTransformer.district : termsSampleTransformer.district",
            "provinceCode": "usersInfoTransformer.provinceCode",
            "districtCode": "usersInfoTransformer.districtCode",
            "totalRecords": "termsSampleTransformer.totalRecords",
            "latestSyncTime": "termsSampleTransformer.latestSyncTime",
            "active": "termsSampleTransformer.active ? termsSampleTransformer.active : 'INACTIVE'",
            "fullLocation": "concat(usersInfoTransformer.province ? usersInfoTransformer.province: termsSampleTransformer.province, ' - ', usersInfoTransformer.district ? usersInfoTransformer.district : termsSampleTransformer.district)"
          }
        ]
      }
    ],
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "mergedUsersSummary"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "mergedUsersSummary"
    ],
    "insight": {},
    "_comment": " "
  },
  "usersRecordsSummaryTable": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "ba-project-task-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "taskTransformer",
        "aggrQuery": "{\"size\":100,\"query\":{\"bool\":{\"must\":[],\"must_not\":[]}},\"_source\":[\"Data.geoPoint\",\"Data.taskId\",\"Data.productName\",\"Data.administrationStatus\",\"Data.@timestamp\",\"Data.quantity\",\"Data.latitude\",\"Data.longitude\",\"Data.boundaryHierarchy.subHills\",\"Data.additionalDetails.cycleIndex\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "ba-stock-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "stockTransformer",
        "aggrQuery": "{\"size\":100,\"query\":{\"bool\":{\"must\":[]}},\"_source\":[\"Data.id\",\"Data.productName\",\"Data.eventType\",\"Data.reason\",\"Data.facilityName\",\"Data.transactingFacilityName\",\"Data.@timestamp\",\"Data.pkhysicalCount\",\"Data.additionalDetails.lat\",\"Data.additionalDetails.lng\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.auditDetails.createdTime",
        "requestQueryMap": "{\"userId\": \"Data.userId.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "ba-transformed-errors-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "errorTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[{}]}},\"_source\":[\"Data.id\",\"Data.errorCategory\",\"Data.@timestamp\"]}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "taskTransformer": {
        "transformationMappings": [
          {
            "id": "Data.taskId",
            "timestamp": "Data.@timestamp",
            "actionType": "'Delivery'",
            "detail": "Data.administrationStatus === 'ADMINISTRATION_SUCCESS' ? `Delivered ${Data.quantity} of ${Data.productName}` : Data.administrationStatus",
            "gps": "Data.geoPoint[1] && Data.geoPoint[0]? `${Data.geoPoint[1]}, ${Data.geoPoint[0]}` : '-'",
            "outcome": "Data.administrationStatus === 'ADMINISTRATION_SUCCESS' ? 'SUCCESS': Data.administrationStatus"
          }
        ]
      },
      "stockTransformer": {
        "transformationMappings": [
          {
            "id": "Data.id",
            "timestamp": "Data.@timestamp",
            "actionType": "'Stock'",
            "detail": "Data.eventType === 'RECEIVED' && Data.reason === 'RETURNED' ? `${Data.facilityName} Got Return Stock of ${Data.physicalCount} ${Data.productName} from ${Data.transactingFacilityName}` : Data.eventType === 'RECEIVED' ? `${Data.facilityName} Received ${Data.physicalCount} ${Data.productName} from ${Data.transactingFacilityName}` : `${Data.facilityName} Dispatched ${Data.physicalCount} ${Data.productName} to ${Data.transactingFacilityName}`",
            "gps": "Data.additionalDetails.lat && Data.additionalDetails.lng ? `${Data.additionalDetails.lat}, ${Data.additionalDetails.lng}` : '-'",
            "outcome": "'SUCCESS'"
          }
        ]
      },
      "errorTransformer": {
        "transformationMappings": [
          {
            "id": "Data.id",
            "timestamp": "Data.@timestamp",
            "actionType": "'Error Record'",
            "detail": "Data.errorCategory",
            "gps": "'-'",
            "outcome": "'FAILED'"
          }
        ]
      }
    },
    "merges": [
      {
        "mergeKey": "mergedUsersRecordTaskStockSummary",
        "baseDataset": "taskTransformer",
        "dataset": "stockTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "concat",
        "clearDatasets": [
          "taskTransformer",
          "stockTransformer"
        ]
      },
      {
        "mergeKey": "mergedUsersRecordSummary",
        "baseDataset": "mergedUsersRecordTaskStockSummary",
        "dataset": "errorTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "concat",
        "clearDatasets": [
          "mergedUsersRecordTaskStockSummary",
          "errorTransformer"
        ]
      }
    ],
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "mergedUsersRecordSummary"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "mergedUsersRecordSummary"
    ],
    "insight": {},
    "_comment": " "
  },
  "commodityStockSummary": {
    "chartName": "DSS_COMMODITY_STOCK_SUMMARY",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "Data.dateOfEntry",
        "requestQueryMap": "{\"campaignId\": \"Data.campaignId.keyword\"}",
        "indexName": "ba-stock-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "stockDataTransformer",
        "aggrQuery": "{\"size\":10000,\"_source\":[\"Data.*\"],\"aggs\":{\"by_event_type\":{\"terms\":{\"field\":\"Data.eventType.keyword\",\"size\":20},\"aggs\":{\"total_quantity\":{\"sum\":{\"field\":\"Data.physicalCount\"}}}},\"by_product\":{\"terms\":{\"field\":\"Data.productName.keyword\",\"size\":100},\"aggs\":{\"by_event_type\":{\"terms\":{\"field\":\"Data.eventType.keyword\",\"size\":20},\"aggs\":{\"total_quantity\":{\"sum\":{\"field\":\"Data.physicalCount\"}}}},\"total_quantity\":{\"sum\":{\"field\":\"Data.physicalCount\"}}}},\"unique_facilities\":{\"cardinality\":{\"field\":\"Data.facilityId.keyword\"}},\"by_facility\":{\"terms\":{\"field\":\"Data.facilityId.keyword\",\"size\":500},\"aggs\":{\"facility_name\":{\"terms\":{\"field\":\"Data.facilityName.keyword\",\"size\":1}},\"by_event_type\":{\"terms\":{\"field\":\"Data.eventType.keyword\",\"size\":20},\"aggs\":{\"total_quantity\":{\"sum\":{\"field\":\"Data.physicalCount\"}}}}}},\"by_projectId\":{\"terms\":{\"field\":\"Data.projectId.keyword\",\"size\":20}},\"total_quantity\":{\"sum\":{\"field\":\"Data.physicalCount\"}}}}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "stockDataTransformer": {
        "transformationMappings": [
          {
            "id": "Data.id",
            "clientReferenceId": "Data.clientReferenceId",
            "productVariantId": "Data.productVariant",
            "transactionType": "Data.eventType",
            "quantity": "Data.physicalCount",
            "projectId": "Data.projectId",
            "campaignId": "Data.campaignId",
            "facilityId": "Data.facilityId",
            "facilityName": "Data.facilityName",
            "transactingFacilityId": "Data.transactingFacilityId",
            "transactingFacilityName": "Data.transactingFacilityName",
            "facilityType": "Data.facilityType",
            "transactingFacilityType": "Data.transactingFacilityType",
            "productName": "Data.productName",
            "userName": "Data.userName",
            "nameOfUser": "Data.nameOfUser",
            "createdTime": "Data.createdTime",
            "dateOfEntry": "Data.dateOfEntry"
          }
        ]
      }
    },
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "campaignId"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "stockDataTransformer",
      "by_event_type",
      "by_product",
      "unique_facilities",
      "by_facility",
      "by_projectId",
      "total_quantity"
    ],
    "insight": {},
    "_comment": "Stock summary for commodity dashboard. Fetches all stock transactions from ba-stock-index-v1 filtered by campaignId. Returns raw hits (transformed to stock API shape) plus aggregations: by_event_type (RECEIVED/DISPATCHED/RETURNED/DAMAGED with quantity sums), by_product (per-product event type + quantity breakdown), unique_facilities (cardinality), by_facility (per-facility event type breakdown with facility name), by_projectId, and total_quantity. Used by useKibanaStockSearch.js → useStockData.js → CommodityDashboard.js for both TransactionSummaryTab and StockSummaryTab."
  },


{
  "testUserPerformance": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-project-task-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "taskTransformer",
        "aggrQuery": "{\"size\":100,\"query\":{\"bool\":{\"must\":[{\"exists\":{\"field\":\"Data.geoPoint\"}}],\"must_not\":[{\"range\":{\"Data.locationAccuracy\":{\"gte\":5}}}]}},\"_source\":[\"Data.geoPoint\",\"Data.taskId\",\"Data.productName\",\"Data.administrationStatus\",\"Data.@timestamp\",\"Data.quantity\",\"Data.latitude\",\"Data.longitude\",\"Data.boundaryHierarchy.subHills\",\"Data.additionalDetails.cycleIndex\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-household-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "linearSampleTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"FILTER\":{\"filter\":{\"bool\":{\"must_not\":[{\"term\":{\"Data.additionalDetails.status.keyword\":\"CLOSED_HOUSEHOLD\"}},{\"terms\":{\"Data.additionalDetails.communityKey.keyword\":[\"refugee_camps\",\"special_groups\"]}}]}},\"aggs\":{\"DateRange visits\":{\"value_count\":{\"field\":\"Data.household.id.keyword\"}}}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-household-index-v1",
        "transformData": "termsAggregation",
        "transformKey": "termsSampleTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Username\":{\"terms\":{\"field\":\"Data.userName.keyword\",\"size\":10000},\"aggs\":{\"LatestSyncedTime\":{\"max\":{\"field\":\"Data.syncedTimeStamp\"}},\"RecordTotal\":{\"value_count\":{\"field\":\"Data.@timestamp\"}}}}}}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "taskTransformer": {
        "transformationMappings": [
          {
            "id": "Data.taskId",
            "timestamp": "Data.@timestamp",
            "actionType": "'Delivery'",
            "longitude": "Data.geoPoint[0]",
            "latitude": "Data.geoPoint[1]",
            "detail": "Data.administrationStatus === 'ADMINISTRATION_SUCCESS' ? `Delivered ${Data.quantity} ${Data.productName}` : ''",
            "gps": "Data.geoPoint[1] && Data.geoPoint[0]? `${Data.geoPoint[1]}, ${Data.geoPoint[0]}` : '-'",
            "testNumber": "1000",
            "geoPointLength": "size(Data.geoPoint)",
            "date": "formatDate(Data.@timestamp, 'dd-MM-yyyy')",
            "dateTime": "formatDate(Data.@timestamp, 'dd-MM-yyyy HH:mm:ss')",
            "statusUpper": "toUpperCase(Data.administrationStatus)",
            "statusLower": "toLowerCase(Data.administrationStatus)",
            "rssDelivery": "concat(Data.productName, ' ', Data.taskType)",
            "shortProductName": "substr(Data.productName, 0, 3)",
            "cleanStatus": "replace(Data.administrationStatus, '_', ' ')",
            "geoPointsJoin": "join(Data.geoPoint, ', ')",
            "coalesce": "coalesce(Data.villageName, Data.boundaryHierarchy.subHills, 'Unknown')",
            "quantityStr": "toString(Data.quantity)",
            "cycleNumber": "toNumber(Data.additionalDetails.cycleIndex)",
            "active": "true",
            "outcome": "Data.administrationStatus1 || '-'",
            "accuraryStatus": "Data.quantity <= 3 ? 'HIGH' : 'NORMAL'",
            "formattedDate": "Data.@timestamp ? formatDate(Data.@timestamp, 'yyyy-MM-dd') : '-'"
          },
          {
            "id1": "Data.taskId",
            "timestamp1": "Data.@timestamp",
            "actionType1": "'Delivery'",
            "longitude1": "Data.geoPoint[0]",
            "latitude1": "Data.geoPoint[1]"
          }
        ]
      },
      "linearSampleTransformer": {
        "transformationMappings": [
          {
            "TotalDateRangeVisits": "FILTER.DateRange visits.value",
            "FilteredDocCount": "FILTER.doc_count"
          }
        ]
      },
      "termsSampleTransformer": {
        "bucketsPath": "Username.buckets",
        "transformationMappings": [
          {
            "username": "key",
            "totalRecords": "RecordTotal.value",
            "latestSyncTime": "LatestSyncedTime.value_as_string",
            "latestSyncEpoch": "toNumber(LatestSyncedTime.value)",
            "docCount": "doc_count"
          }
        ]
      }
    },
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "Users"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "taskTransformer"
    ],
    "insight": {},
    "_comment": " "
  },
  "usersSummary": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-project-staff-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "usersInfoTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[{\"wildcard\":{\"Data.userName.keyword\":{\"value\":\"bi-uat*\"}}},{\"term\":{\"Data.role.keyword\":{\"value\":\"DISTRIBUTOR\"}}},{\"exists\":{\"field\":\"Data.boundaryHierarchy.district\"}}]}},\"_source\":[\"Data.userId\",\"Data.userName\",\"Data.role\",\"Data.boundaryHierarchy.district\",\"Data.boundaryHierarchy.province\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-project-staff-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "usersCountTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Total Users Count\":{\"cardinality\":{\"field\":\"Data.userId.keyword\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-user-sync-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "activeUsersTransformer",
        "aggrQuery": "{\"size\":0,\"query\":{\"bool\":{\"must\":[{\"range\":{\"Data.@timestamp\":{\"lte\":\"now-3h\"}}}]}},\"aggs\":{\"Active Users\":{\"cardinality\":{\"field\":\"Data.syncedUserId.keyword\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "",
        "requestQueryMap": "{\"province\": \"Data.boundaryHierarchy.province.keyword\", \"projectId\": \"Data.projectId.keyword\", \"createdBy\": \"Data.createdBy.keyword\"}",
        "indexName": "ba-user-sync-index-v1",
        "transformData": "termsAggregation",
        "transformKey": "termsSampleTransformer",
        "aggrQuery": "{\"size\":0,\"query\":{\"bool\":{\"must\":[{\"wildcard\":{\"Data.syncedUserName.keyword\":{\"value\":\"bi-uat*\"}}},{\"term\":{\"Data.role.keyword\":{\"value\":\"DISTRIBUTOR\"}}},{\"exists\":{\"field\":\"Data.boundaryHierarchy.district\"}}]}},\"aggs\":{\"Username\":{\"terms\":{\"field\":\"Data.syncedUserId.keyword\",\"size\":10000},\"aggs\":{\"LatestSyncedTime\":{\"max\":{\"field\":\"Data.syncedTimeStamp\"}},\"RecordTotal\":{\"value_count\":{\"field\":\"Data.@timestamp\"}},\"Last3Hours\":{\"filter\":{\"range\":{\"Data.@timestamp\":{\"gte\":\"now-200d\",\"lte\":\"now\"}}}},\"LatestDoc\":{\"top_hits\":{\"size\":1,\"sort\":[{\"Data.@timestamp\":{\"order\":\"desc\"}}],\"_source\":{\"includes\":[\"Data.syncedUserName\",\"Data.@timestamp\",\"Data.boundaryHierarchy.district\",\"Data.boundaryHierarchy.province\",\"Data.role\",\"Data.syncedTimeStamp\"]}}}}}}}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "usersCountTransformer": {
        "transformationMappings": [
          {
            "totalUsersCreated": "Total Users Count.value"
          }
        ]
      },
      "activeUsersTransformer": {
        "transformationMappings": [
          {
            "totalUsersActive": "Active Users.value"
          }
        ]
      },
      "usersInfoTransformer": {
        "transformationMappings": [
          {
            "userId": "Data.userId",
            "userName": "Data.userName",
            "role": "Data.role",
            "province": "Data.boundaryHierarchy.province",
            "district": "Data.boundaryHierarchy.district"
          }
        ]
      },
      "termsSampleTransformer": {
        "bucketsPath": "Username.buckets",
        "transformationMappings": [
          {
            "userId": "key",
            "userName": "LatestDoc.hits.hits[0]._source.Data.syncedUserName",
            "role": "LatestDoc.hits.hits[0]._source.Data.role",
            "province": "LatestDoc.hits.hits[0]._source.Data.boundaryHierarchy.province",
            "district": "LatestDoc.hits.hits[0]._source.Data.boundaryHierarchy.district",
            "totalRecords": "RecordTotal.value",
            "latestSyncTime": "LatestSyncedTime.value_as_string",
            "latestSyncEpoch": "toNumber(LatestSyncedTime.value)",
            "active": "Last3Hours.doc_count > 0 ? 'ACTIVE' : 'INACTIVE'"
          }
        ]
      }
    },
    "merges": [
      {
        "mergeKey": "mergedUsersSummary",
        "baseDataset": "usersInfoTransformer",
        "dataset": "termsSampleTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "full",
        "clearDatasets": [
          "usersInfoTransformer",
          "termsSampleTransformer"
        ],
        "outputMappings": [
          {
            "userId": "usersInfoTransformer.userId ? usersInfoTransformer.userId : termsSampleTransformer.userId",
            "userName": "usersInfoTransformer.userName ? usersInfoTransformer.userName : termsSampleTransformer.userName",
            "role": "usersInfoTransformer.role ? usersInfoTransformer.role: termsSampleTransformer.role",
            "province": "usersInfoTransformer.province ? usersInfoTransformer.province: termsSampleTransformer.province",
            "district": "usersInfoTransformer.district ? usersInfoTransformer.district : termsSampleTransformer.district",
            "totalRecords": "termsSampleTransformer.totalRecords",
            "latestSyncTime": "termsSampleTransformer.latestSyncTime",
            "active": "termsSampleTransformer.active",
            "fullLocation": "concat(usersInfoTransformer.province ? usersInfoTransformer.province: termsSampleTransformer.province, ' - ', usersInfoTransformer.district ? usersInfoTransformer.district : termsSampleTransformer.district)"
          }
        ]
      },
      {
        "mergeType": "linear",
        "mergeKey": "combinedUserStats",
        "flatten": true,
        "datasets": [
          "usersCountTransformer",
          "activeUsersTransformer"
        ],
        "clearDatasets": [
          "usersCountTransformer",
          "activeUsersTransformer"
        ],
        "outputMappings": [
          {
            "totalUsersCreated": "usersCountTransformer.totalUsersCreated",
            "totalUsersActive": "activeUsersTransformer.totalUsersActive",
            "inactiveUsers": "subtract(usersCountTransformer.totalUsersCreated, activeUsersTransformer.totalUsersActive)",
            "activePercentage": "multiply(divide(activeUsersTransformer.totalUsersActive, usersCountTransformer.totalUsersCreated), 100)"
          }
        ]
      }
    ],
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "Users"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "mergedUsersSummary",
      "totalUsersCreated",
      "totalUsersActive",
      "inactiveUsers",
      "activePercentage"
    ],
    "insight": {},
    "_comment": " "
  },

